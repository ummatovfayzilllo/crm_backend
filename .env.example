# ========================
# SERVER CONFIGURATION
# ========================
PORT=15976
HOST=localhost
APP_BASE_URL=http://localhost:15976
NODE_ENV=development

# ========================
# DATABASE CONFIGURATION
# ========================
DATABASE_URL="postgresql://user:password@localhost:5432/crm_app?schema=public"

# ========================
# JWT CONFIGURATION
# ========================
JWT_ACCESS_SECRET=your_super_secret_access_key_here
JWT_ACCESS_EXPIRES_IN=3d

JWT_SESSION_SECRET=your_super_secret_session_key_here
JWT_SESSION_EXPIRES_IN=5m

JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_REFRESH_EXPIRES_IN=7d

TURNSTILE_SHARED_SECRET="optional-shared-secret-for-turnstile-webhook"
RATE_LIMIT_TTL_MS="60000"
RATE_LIMIT_MAX="100"
REDIS_URL="redis://localhost:6379"
CACHE_TTL_SECONDS="300"
